# Copie para .env e preencha.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Segredo usado para assinar o token de login (JWT). Use um texto longo e aleatório.
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Deixe "false" até web e mobile atualizados estarem publicados; depois mude para "true".
AUTH_OBRIGATORIA="false"

# Envio automático do pedido de compra ao fornecedor (Gmail com senha de app).
EMAIL_USER=""
EMAIL_PASS=""
