generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IMPORTANTE: todas as alterações deste arquivo são ADITIVAS
// (campos opcionais / com default e tabelas novas). Rode
// `npx prisma db push` para aplicar sem perder dados.
// ============================================================

model Categoria {
  id        String    @id @default(uuid())
  nome      String
  descricao String?
  produtos  Produto[]
}

model Localizacao {
  id         String    @id @default(uuid())
  codigo     String    @unique
  zona       String
  corredor   String
  prateleira String
  armazemId  String?   // ✨ FASE 2
  armazem    Armazem?  @relation(fields: [armazemId], references: [id])
  estoques   Estoque[]
}

// ============================================================
// ✨ FASE 2: ARMAZÉNS (multiarmazém: Munila, VIAPRO...)
// ============================================================
model Armazem {
  id         String         @id @default(uuid())
  codigo     String         @unique
  nome       String
  endereco   String?
  padrao     Boolean        @default(false)
  ativo      Boolean        @default(true)
  createdAt  DateTime       @default(now())
  estoques   Estoque[]
  locais     Localizacao[]
  ordens     OrdemTransferencia[]
  inventarios Inventario[]
}

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  cargo         String
  email         String         @unique
  senha         String
  pushToken     String?

  estoques      Estoque[]
  movimentacoes Movimentacao[]

  ordensSolicitadas OrdemTransferencia[] @relation("OrdensSolicitadas")
  ordensSeparadas   OrdemTransferencia[] @relation("OrdensSeparadas")
  inventarios       Inventario[]         @relation("InventarioResponsavel")
  contagens         InventarioItem[]     @relation("InventarioContador")
}

model Produto {
  id                  String         @id @default(uuid())
  sku                 String         @unique
  nome                String
  descricao           String?
  codigoBarras        String?        @unique
  tipo                String         @default("ACABADO")
  precoCusto          Float?         @default(0)
  precoVenda          Float?         @default(0)
  imagemUrl           String?
  dataCadastro        DateTime       @default(now())
  lote                String?
  enderecoLocalizacao String?

  // ✨ NOVOS CAMPOS (parâmetros de reposição e validade)
  unidade             String?        @default("UN")
  estoqueMinimo       Int?
  estoqueMaximo       Int?
  leadTimeDias        Int?
  validade            DateTime?

  // ✨ FASE 2: dados fiscais (preparação para NF-e)
  ncm                 String?
  cest                String?
  origemFiscal        Int?           // 0 nacional, 1 importação direta, 2 importada adquirida no mercado interno...
  cfopPadrao          String?

  fornecedorId        String?
  fornecedor          Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  categoriaId         String
  categoria           Categoria      @relation(fields: [categoriaId], references: [id])
  estoques            Estoque[]
  movimentacoes       Movimentacao[]
  pedidosCompra       PedidoCompra[]
  receitaParaOutros   Composicao[]   @relation("ProdutoFilho")
  ingredientes        Composicao[]   @relation("ProdutoPai")
  itensTransferencia  ItemOrdemTransferencia[]
  itensInventario     InventarioItem[]
}

model Composicao {
  id             String  @id @default(uuid())
  produtoPaiId   String
  produtoFilhoId String
  quantidade     Int

  produtoPai     Produto @relation("ProdutoPai", fields: [produtoPaiId], references: [id], onDelete: Cascade)
  produtoFilho   Produto @relation("ProdutoFilho", fields: [produtoFilhoId], references: [id])

  @@unique([produtoPaiId, produtoFilhoId])
}

model Estoque {
  id            String       @id @default(uuid())
  produtoId     String
  produto       Produto      @relation(fields: [produtoId], references: [id])
  quantidade    Int
  status        String
  localizacaoId String?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation(fields: [responsavelId], references: [id])

  // ✨ FASE 2: saldo por armazém e por lote (FEFO)
  armazemId     String?
  armazem       Armazem?     @relation(fields: [armazemId], references: [id])
  lote          String?
  validade      DateTime?

  @@index([produtoId, status])
}

model Movimentacao {
  id                  String    @id @default(uuid())
  produtoId           String
  usuarioId           String
  quantidade          Int
  tipoAcao            String
  codigo              String?
  observacao          String?
  dataPrevistaRetorno DateTime?
  dataHora            DateTime  @default(now())

  // ✨ FASE 2: rastreabilidade de armazém e lote
  armazemId           String?
  lote                String?
  validade            DateTime?

  produto Produto @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([produtoId, dataHora])
  @@index([dataHora])
}

model Fornecedor {
  id          String         @id @default(uuid())
  nomeEmpresa String
  cnpj        String?
  contatoNome String?
  telefone    String?
  email       String?
  prazoPagamentoDias Int?    // ✨ FASE 2: prazo padrão para o contas a pagar
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  produtos      Produto[]
  pedidosCompra PedidoCompra[]
  titulos       Titulo[]
}

model PedidoCompra {
  id           String     @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  produtoId    String
  produto      Produto    @relation(fields: [produtoId], references: [id])
  codigo       String?
  quantidade   Int
  custoTotal   Float
  dataPrevisao DateTime?
  status       String     @default("Pendente")

  // ✨ NOVOS CAMPOS (recebimento com conferência cega)
  quantidadeRecebida Int?
  divergencia        String?
  dataRecebimento    DateTime?
  observacao         String?
  titulos            Titulo[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LogAuditoria {
  id          String   @id @default(uuid())
  acao        String
  itemNome    String
  usuarioNome String
  motivo      String   @db.Text
  dataHora    DateTime @default(now())
}

model OrdemTransferencia {
  id            String    @id @default(uuid())
  codigo        String    @unique
  status        String    @default("Pendente")
  tipo          String    @default("SAIDA")
  prioridade    String    @default("Normal")
  solicitanteId String
  solicitante   Usuario   @relation("OrdensSolicitadas", fields: [solicitanteId], references: [id])
  separadorId   String?
  separador     Usuario?  @relation("OrdensSeparadas", fields: [separadorId], references: [id])
  itens         ItemOrdemTransferencia[]

  // ✨ NOVOS CAMPOS (produtividade da separação)
  observacao    String?
  armazemId     String?   // ✨ FASE 2: armazém de onde sai / para onde entra
  armazem       Armazem?  @relation(fields: [armazemId], references: [id])
  iniciadaEm    DateTime?
  concluidaEm   DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ItemOrdemTransferencia {
  id                 String             @id @default(uuid())
  quantidade         Int
  marcado            Boolean            @default(false)
  ordemId            String
  ordem              OrdemTransferencia @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto            @relation(fields: [produtoId], references: [id])
}

model TransformacaoItem {
  id         String   @id @default(uuid())
  tipo       String
  sku        String   @unique
  nome       String
  quantidade Float    @default(0)
  lote       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TransformacaoLote {
  id           String   @id @default(uuid())
  codigoLote   String
  produtoNome  String
  produtoSku   String
  quantidade   Float
  receitaUsada Json
  createdAt    DateTime @default(now())
}

model TransformacaoAuditoria {
  id             String   @id @default(uuid())
  acao           String
  detalhes       String
  usuario        String
  loteInfo       String?
  quantidadeInfo Float?
  dataHora       DateTime @default(now())
}

// ============================================================
// ✨ NOVO MÓDULO: INVENTÁRIO (geral ou cíclico, com contagem cega)
// ============================================================
model Inventario {
  id            String           @id @default(uuid())
  codigo        String           @unique
  descricao     String?
  tipo          String           @default("Cíclico") // Geral | Cíclico
  status        String           @default("Aberto")  // Aberto | Em contagem | Concluído | Cancelado
  cego          Boolean          @default(true)
  responsavelId String?
  responsavel   Usuario?         @relation("InventarioResponsavel", fields: [responsavelId], references: [id])
  armazemId     String?          // ✨ FASE 2
  armazem       Armazem?         @relation(fields: [armazemId], references: [id])
  itens         InventarioItem[]
  createdAt     DateTime         @default(now())
  concluidoEm   DateTime?
}

model InventarioItem {
  id                String     @id @default(uuid())
  inventarioId      String
  inventario        Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId         String
  produto           Produto    @relation(fields: [produtoId], references: [id])
  saldoSistema      Int
  quantidadeContada Int?
  contadoPorId      String?
  contadoPor        Usuario?   @relation("InventarioContador", fields: [contadoPorId], references: [id])
  contadoEm         DateTime?
  ajustado          Boolean    @default(false)
  lotesContados     Json?      // ✨ FASE 2: [{ lote, validade, quantidade }] quando a contagem é feita por lote

  @@unique([inventarioId, produtoId])
}

// ============================================================
// ✨ FASE 2: FINANCEIRO (contas a pagar / receber e fluxo de caixa)
// ============================================================
model ContaBancaria {
  id           String   @id @default(uuid())
  nome         String
  saldoInicial Float    @default(0)
  ativa        Boolean  @default(true)
  createdAt    DateTime @default(now())
  titulos      Titulo[]
}

model Titulo {
  id             String         @id @default(uuid())
  tipo           String         // PAGAR | RECEBER
  descricao      String
  categoria      String?        // Fornecedores, Frete, Impostos, Vendas...
  documento      String?        // NF, boleto, pedido
  parcela        String?        // "1/3"
  valor          Float
  vencimento     DateTime
  status         String         @default("Aberto") // Aberto | Pago | Cancelado
  valorPago      Float?
  dataPagamento  DateTime?
  formaPagamento String?
  observacao     String?
  pessoa         String?        // cliente ou favorecido quando não é fornecedor cadastrado
  fornecedorId   String?
  fornecedor     Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  pedidoCompraId String?
  pedidoCompra   PedidoCompra?  @relation(fields: [pedidoCompraId], references: [id])
  contaId        String?
  conta          ContaBancaria? @relation(fields: [contaId], references: [id])
  usuarioNome    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tipo, status, vencimento])
}

// ============================================================
// ✨ FASE 2: DADOS DA EMPRESA (base para a emissão de NF-e)
// ============================================================
model ConfiguracaoEmpresa {
  id                String   @id @default("empresa")
  razaoSocial       String?
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  regimeTributario  String?  // Simples Nacional | Lucro Presumido | Lucro Real
  cep               String?
  logradouro        String?
  numero            String?
  bairro            String?
  cidade            String?
  uf                String?
  telefone          String?
  email             String?
  emissorNFe        String?  // provedor escolhido (ex.: Focus NFe) — integração futura
  ambienteNFe       String?  @default("homologacao")
  updatedAt         DateTime @updatedAt
}
