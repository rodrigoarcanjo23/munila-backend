generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        String    @id @default(uuid())
  nome      String
  descricao String?
  produtos  Produto[]
}

model Localizacao {
  id         String    @id @default(uuid())
  codigo     String    @unique
  zona       String
  corredor   String
  prateleira String
  estoques   Estoque[]
}

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  cargo         String
  email         String         @unique
  senha         String
  
  // ✨ CAMPO PARA NOTIFICAÇÕES PUSH ✨
  pushToken     String?

  estoques      Estoque[]
  movimentacoes Movimentacao[]

  ordensSolicitadas OrdemTransferencia[] @relation("OrdensSolicitadas")
  ordensSeparadas   OrdemTransferencia[] @relation("OrdensSeparadas")
}

model Produto {
  id                  String         @id @default(uuid())
  sku                 String         @unique
  nome                String
  descricao           String?
  codigoBarras        String?        @unique
  tipo                String         @default("ACABADO") 
  precoCusto          Float?         @default(0)
  precoVenda          Float?         @default(0)
  imagemUrl           String?
  dataCadastro        DateTime       @default(now()) 
  lote                String?
  enderecoLocalizacao String?        
  fornecedorId        String?
  fornecedor          Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  categoriaId         String
  categoria           Categoria      @relation(fields: [categoriaId], references: [id])
  estoques            Estoque[]
  movimentacoes       Movimentacao[]
  pedidosCompra       PedidoCompra[]
  receitaParaOutros   Composicao[]   @relation("ProdutoFilho")
  ingredientes        Composicao[]   @relation("ProdutoPai")
  itensTransferencia  ItemOrdemTransferencia[]
}

model Composicao {
  id             String  @id @default(uuid())
  produtoPaiId   String  
  produtoFilhoId String  
  quantidade     Int     

  produtoPai     Produto @relation("ProdutoPai", fields: [produtoPaiId], references: [id], onDelete: Cascade)
  produtoFilho   Produto @relation("ProdutoFilho", fields: [produtoFilhoId], references: [id])

  @@unique([produtoPaiId, produtoFilhoId]) 
}

model Estoque {
  id            String       @id @default(uuid())
  produtoId     String
  produto       Produto      @relation(fields: [produtoId], references: [id])
  quantidade    Int
  status        String       
  localizacaoId String?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation(fields: [responsavelId], references: [id])
}

model Movimentacao {
  id                  String    @id @default(uuid())
  produtoId           String
  usuarioId           String
  quantidade          Int
  tipoAcao            String    
  codigo              String?   
  observacao          String?
  dataPrevistaRetorno DateTime?
  dataHora            DateTime  @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Fornecedor {
  id          String         @id @default(uuid())
  nomeEmpresa String
  cnpj        String?
  contatoNome String?
  telefone    String?
  email       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  produtos      Produto[]
  pedidosCompra PedidoCompra[]
}

model PedidoCompra {
  id           String    @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  produtoId    String
  produto      Produto    @relation(fields: [produtoId], references: [id])
  codigo       String?   
  quantidade   Int
  custoTotal   Float
  dataPrevisao DateTime?
  status       String    @default("Pendente") 
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LogAuditoria {
  id          String   @id @default(uuid())
  acao        String
  itemNome    String
  usuarioNome String
  motivo      String   @db.Text
  dataHora    DateTime @default(now())
}

model OrdemTransferencia {
  id            String    @id @default(uuid())
  codigo        String    @unique 
  status        String    @default("Pendente") 
  tipo          String    @default("SAIDA") 
  prioridade    String    @default("Normal") 
  solicitanteId String
  solicitante   Usuario   @relation("OrdensSolicitadas", fields: [solicitanteId], references: [id])
  separadorId   String?
  separador     Usuario?  @relation("OrdensSeparadas", fields: [separadorId], references: [id])
  itens         ItemOrdemTransferencia[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ItemOrdemTransferencia {
  id                 String             @id @default(uuid())
  quantidade         Int
  marcado            Boolean            @default(false) 
  ordemId            String
  ordem              OrdemTransferencia @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto            @relation(fields: [produtoId], references: [id])
}

model TransformacaoItem {
  id         String   @id @default(uuid())
  tipo       String   
  sku        String   @unique
  nome       String
  quantidade Float    @default(0)
  lote       String?  // ✨ CAMPO LOTE ESTOQUE CONSOLIDADO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TransformacaoLote {
  id           String   @id @default(uuid())
  codigoLote   String   
  produtoNome  String
  produtoSku   String
  quantidade   Float
  receitaUsada Json     
  createdAt    DateTime @default(now())
}

model TransformacaoAuditoria {
  id             String   @id @default(uuid())
  acao           String   
  detalhes       String
  usuario        String
  loteInfo       String?  // ✨ LOTE PARA BUSCA NO RELATÓRIO
  quantidadeInfo Float?   // ✨ QTD PARA BUSCA NO RELATÓRIO
  dataHora       DateTime @default(now())
}