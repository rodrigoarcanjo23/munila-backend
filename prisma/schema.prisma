generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IMPORTANTE: todas as alterações deste arquivo são ADITIVAS
// (campos opcionais / com default e tabelas novas). Rode
// `npx prisma db push` para aplicar sem perder dados.
// ============================================================

model Categoria {
  id        String    @id @default(uuid())
  nome      String
  descricao String?
  produtos  Produto[]
}

model Localizacao {
  id         String    @id @default(uuid())
  codigo     String    @unique
  zona       String
  corredor   String
  prateleira String
  armazemId  String?   // ✨ FASE 2
  armazem    Armazem?  @relation(fields: [armazemId], references: [id])
  estoques   Estoque[]

  // ✨ FASE 7: posição física para mapa, slotting e rota de separação
  rua        String?            // corredor (A, B, 01, 02...)
  modulo     Int?               // posição ao longo da rua, a partir da frente (expedição)
  nivel      Int?               // 1 = chão; 2 = altura da cintura (zona dourada); 4+ = precisa de escada
  tipo       String?  @default("Picking") // Picking | Pulmão | Chão | Doca
  ativo      Boolean  @default(true)
}

// ============================================================
// ✨ FASE 2: ARMAZÉNS (multiarmazém: Munila, VIAPRO...)
// ============================================================
model Armazem {
  id         String         @id @default(uuid())
  codigo     String         @unique
  nome       String
  endereco   String?
  padrao     Boolean        @default(false)
  ativo      Boolean        @default(true)
  createdAt  DateTime       @default(now())
  estoques   Estoque[]
  locais     Localizacao[]
  ordens     OrdemTransferencia[]
  inventarios Inventario[]
  ordensProducao OrdemProducao[]
}

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  cargo         String
  email         String         @unique
  senha         String
  pushToken     String?

  estoques      Estoque[]
  movimentacoes Movimentacao[]

  ordensSolicitadas OrdemTransferencia[] @relation("OrdensSolicitadas")
  ordensSeparadas   OrdemTransferencia[] @relation("OrdensSeparadas")
  inventarios       Inventario[]         @relation("InventarioResponsavel")
  contagens         InventarioItem[]     @relation("InventarioContador")

  ordensProducao    OrdemProducao[]       @relation("OPResponsavel")
  apontamentos      ApontamentoProducao[] @relation("Apontamentos")
}

model Produto {
  id                  String         @id @default(uuid())
  sku                 String         @unique
  nome                String
  descricao           String?
  codigoBarras        String?        @unique
  tipo                String         @default("ACABADO")
  precoCusto          Float?         @default(0)
  precoVenda          Float?         @default(0)
  imagemUrl           String?
  dataCadastro        DateTime       @default(now())
  lote                String?
  enderecoLocalizacao String?

  // ✨ NOVOS CAMPOS (parâmetros de reposição e validade)
  unidade             String?        @default("UN")
  estoqueMinimo       Int?
  estoqueMaximo       Int?
  leadTimeDias        Int?
  validade            DateTime?

  // ✨ FASE 2: dados fiscais (preparação para NF-e)
  ncm                 String?
  cest                String?
  origemFiscal        Int?           // 0 nacional, 1 importação direta, 2 importada adquirida no mercado interno...
  cfopPadrao          String?

  fornecedorId        String?
  fornecedor          Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  categoriaId         String
  categoria           Categoria      @relation(fields: [categoriaId], references: [id])
  estoques            Estoque[]
  movimentacoes       Movimentacao[]
  pedidosCompra       PedidoCompra[]
  receitaParaOutros   Composicao[]   @relation("ProdutoFilho")
  ingredientes        Composicao[]   @relation("ProdutoPai")
  itensTransferencia  ItemOrdemTransferencia[]
  itensInventario     InventarioItem[]

  // ✨ FASE 4: PCP
  ordensProducao      OrdemProducao[]
  componentesOP       OrdemProducaoComponente[]
  planosProducao      PlanoProducao[]
}

model Composicao {
  id             String  @id @default(uuid())
  produtoPaiId   String
  produtoFilhoId String
  quantidade     Int

  produtoPai     Produto @relation("ProdutoPai", fields: [produtoPaiId], references: [id], onDelete: Cascade)
  produtoFilho   Produto @relation("ProdutoFilho", fields: [produtoFilhoId], references: [id])

  @@unique([produtoPaiId, produtoFilhoId])
}

model Estoque {
  id            String       @id @default(uuid())
  produtoId     String
  produto       Produto      @relation(fields: [produtoId], references: [id])
  quantidade    Int
  status        String
  localizacaoId String?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation(fields: [responsavelId], references: [id])

  // ✨ FASE 2: saldo por armazém e por lote (FEFO)
  armazemId     String?
  armazem       Armazem?     @relation(fields: [armazemId], references: [id])
  lote          String?
  validade      DateTime?

  @@index([produtoId, status])
}

model Movimentacao {
  id                  String    @id @default(uuid())
  produtoId           String
  usuarioId           String
  quantidade          Int
  tipoAcao            String
  codigo              String?
  observacao          String?
  dataPrevistaRetorno DateTime?
  dataHora            DateTime  @default(now())

  // ✨ FASE 2: rastreabilidade de armazém e lote
  armazemId           String?
  lote                String?
  validade            DateTime?

  produto Produto @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([produtoId, dataHora])
  @@index([dataHora])
}

model Fornecedor {
  id          String         @id @default(uuid())
  nomeEmpresa String
  cnpj        String?
  contatoNome String?
  telefone    String?
  email       String?
  prazoPagamentoDias Int?    // ✨ FASE 2: prazo padrão para o contas a pagar
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  produtos      Produto[]
  pedidosCompra PedidoCompra[]
  titulos       Titulo[]
}

model PedidoCompra {
  id           String     @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  produtoId    String
  produto      Produto    @relation(fields: [produtoId], references: [id])
  codigo       String?
  quantidade   Int
  custoTotal   Float
  dataPrevisao DateTime?
  status       String     @default("Pendente")

  // ✨ NOVOS CAMPOS (recebimento com conferência cega)
  quantidadeRecebida Int?
  divergencia        String?
  dataRecebimento    DateTime?
  observacao         String?
  titulos            Titulo[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LogAuditoria {
  id          String   @id @default(uuid())
  acao        String
  itemNome    String
  usuarioNome String
  motivo      String   @db.Text
  dataHora    DateTime @default(now())
}

model OrdemTransferencia {
  id            String    @id @default(uuid())
  codigo        String    @unique
  status        String    @default("Pendente")
  tipo          String    @default("SAIDA")
  prioridade    String    @default("Normal")
  solicitanteId String
  solicitante   Usuario   @relation("OrdensSolicitadas", fields: [solicitanteId], references: [id])
  separadorId   String?
  separador     Usuario?  @relation("OrdensSeparadas", fields: [separadorId], references: [id])
  itens         ItemOrdemTransferencia[]

  // ✨ NOVOS CAMPOS (produtividade da separação)
  observacao    String?
  armazemId     String?   // ✨ FASE 2: armazém de onde sai / para onde entra
  armazem       Armazem?  @relation(fields: [armazemId], references: [id])
  iniciadaEm    DateTime?
  concluidaEm   DateTime?

  // ✨ FASE 7: onda de separação (várias ordens separadas numa única rota)
  ondaId        String?
  onda          OndaSeparacao? @relation(fields: [ondaId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ItemOrdemTransferencia {
  id                 String             @id @default(uuid())
  quantidade         Int
  marcado            Boolean            @default(false)
  ordemId            String
  ordem              OrdemTransferencia @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto            @relation(fields: [produtoId], references: [id])
}

model TransformacaoItem {
  id         String   @id @default(uuid())
  tipo       String
  sku        String   @unique
  nome       String
  quantidade Float    @default(0)
  lote       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TransformacaoLote {
  id           String   @id @default(uuid())
  codigoLote   String
  produtoNome  String
  produtoSku   String
  quantidade   Float
  receitaUsada Json
  createdAt    DateTime @default(now())
}

model TransformacaoAuditoria {
  id             String   @id @default(uuid())
  acao           String
  detalhes       String
  usuario        String
  loteInfo       String?
  quantidadeInfo Float?
  dataHora       DateTime @default(now())
}

// ============================================================
// ✨ NOVO MÓDULO: INVENTÁRIO (geral ou cíclico, com contagem cega)
// ============================================================
model Inventario {
  id            String           @id @default(uuid())
  codigo        String           @unique
  descricao     String?
  tipo          String           @default("Cíclico") // Geral | Cíclico
  status        String           @default("Aberto")  // Aberto | Em contagem | Concluído | Cancelado
  cego          Boolean          @default(true)
  responsavelId String?
  responsavel   Usuario?         @relation("InventarioResponsavel", fields: [responsavelId], references: [id])
  armazemId     String?          // ✨ FASE 2
  armazem       Armazem?         @relation(fields: [armazemId], references: [id])
  itens         InventarioItem[]
  createdAt     DateTime         @default(now())
  concluidoEm   DateTime?
}

model InventarioItem {
  id                String     @id @default(uuid())
  inventarioId      String
  inventario        Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId         String
  produto           Produto    @relation(fields: [produtoId], references: [id])
  saldoSistema      Int
  quantidadeContada Int?
  contadoPorId      String?
  contadoPor        Usuario?   @relation("InventarioContador", fields: [contadoPorId], references: [id])
  contadoEm         DateTime?
  ajustado          Boolean    @default(false)
  lotesContados     Json?      // ✨ FASE 2: [{ lote, validade, quantidade }] quando a contagem é feita por lote

  @@unique([inventarioId, produtoId])
}

// ============================================================
// ✨ FASE 2: FINANCEIRO (contas a pagar / receber e fluxo de caixa)
// ============================================================
model ContaBancaria {
  id           String   @id @default(uuid())
  nome         String
  saldoInicial Float    @default(0)
  ativa        Boolean  @default(true)
  createdAt    DateTime @default(now())
  titulos      Titulo[]
}

model Titulo {
  id             String         @id @default(uuid())
  tipo           String         // PAGAR | RECEBER
  descricao      String
  categoria      String?        // Fornecedores, Frete, Impostos, Vendas...
  documento      String?        // NF, boleto, pedido
  parcela        String?        // "1/3"
  valor          Float
  vencimento     DateTime
  status         String         @default("Aberto") // Aberto | Pago | Cancelado
  valorPago      Float?
  dataPagamento  DateTime?
  formaPagamento String?
  observacao     String?
  pessoa         String?        // cliente ou favorecido quando não é fornecedor cadastrado
  fornecedorId   String?
  fornecedor     Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  pedidoCompraId String?
  pedidoCompra   PedidoCompra?  @relation(fields: [pedidoCompraId], references: [id])
  contaId        String?
  conta          ContaBancaria? @relation(fields: [contaId], references: [id])
  usuarioNome    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tipo, status, vencimento])
}

// ============================================================
// ✨ FASE 2: DADOS DA EMPRESA (base para a emissão de NF-e)
// ============================================================
model ConfiguracaoEmpresa {
  id                String   @id @default("empresa")
  razaoSocial       String?
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  regimeTributario  String?  // Simples Nacional | Lucro Presumido | Lucro Real
  cep               String?
  logradouro        String?
  numero            String?
  bairro            String?
  cidade            String?
  uf                String?
  telefone          String?
  email             String?
  emissorNFe        String?  // provedor escolhido (ex.: Focus NFe) — integração futura
  ambienteNFe       String?  @default("homologacao")
  updatedAt         DateTime @updatedAt
}

// ============================================================
// ✨ FASE 4: PCP (planejamento e controle da produção)
// ============================================================
model RecursoProducao {
  id            String          @id @default(uuid())
  codigo        String          @unique
  nome          String
  tipo          String          @default("Linha") // Linha | Célula | Bancada | Terceiro
  capacidadeDia Float           @default(0)       // unidades por dia
  diasSemana    Int             @default(5)
  eficiencia    Float           @default(85)      // % usada no cálculo de carga
  ativo         Boolean         @default(true)
  observacao    String?
  createdAt     DateTime        @default(now())
  ordens        OrdemProducao[]
}

model OrdemProducao {
  id                  String                    @id @default(uuid())
  codigo              String                    @unique
  produtoId           String
  produto             Produto                   @relation(fields: [produtoId], references: [id])
  quantidadePlanejada Int
  quantidadeProduzida Int                       @default(0)
  quantidadeRefugo    Int                       @default(0)
  status              String                    @default("Planejada") // Planejada | Liberada | Em produção | Pausada | Concluída | Cancelada
  prioridade          String                    @default("Normal")
  origem              String                    @default("Manual")    // Manual | Plano mestre | Sugestão
  inicioPrevisto      DateTime?
  entregaPrevista     DateTime?
  iniciadaEm          DateTime?
  concluidaEm         DateTime?
  recursoId           String?
  recurso             RecursoProducao?          @relation(fields: [recursoId], references: [id])
  armazemId           String?
  armazem             Armazem?                  @relation(fields: [armazemId], references: [id])
  loteProducao        String?
  validade            DateTime?
  observacao          String?
  motivoCancelamento  String?
  responsavelId       String?
  responsavel         Usuario?                  @relation("OPResponsavel", fields: [responsavelId], references: [id])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  componentes         OrdemProducaoComponente[]
  apontamentos        ApontamentoProducao[]

  @@index([status])
  @@index([produtoId])
}

model OrdemProducaoComponente {
  id                  String        @id @default(uuid())
  ordemId             String
  ordem               OrdemProducao @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  produtoId           String
  produto             Produto       @relation(fields: [produtoId], references: [id])
  porUnidade          Int
  quantidadePrevista  Int
  quantidadeConsumida Int           @default(0)

  @@unique([ordemId, produtoId])
}

model ApontamentoProducao {
  id            String        @id @default(uuid())
  ordemId       String
  ordem         OrdemProducao @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  quantidade    Int
  refugo        Int           @default(0)
  minutos       Int?
  lote          String?
  observacao    String?
  codigoEntrada String?
  codigoConsumo String?
  usuarioId     String
  usuario       Usuario       @relation("Apontamentos", fields: [usuarioId], references: [id])
  dataHora      DateTime      @default(now())

  @@index([dataHora])
}

model PlanoProducao {
  id         String   @id @default(uuid())
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  semana     DateTime // segunda-feira da semana (00:00 UTC)
  quantidade Int
  observacao String?
  updatedAt  DateTime @updatedAt

  @@unique([produtoId, semana])
}

// ============================================================
// ✨ FASE 6: TRANSFORMAÇÃO (estoque segregado, NÃO afeta o estoque oficial)
// Razão imutável com hash encadeado; correções só por estorno ou ajuste com motivo.
// ============================================================
model TfMaterial {
  id              String         @id @default(uuid())
  codigo          String         @unique
  nome            String
  tipo            String         @default("MATERIA_PRIMA") // MATERIA_PRIMA | INTERMEDIARIO | PRODUTO | SUBPRODUTO
  unidade         String         @default("UN")
  custoUnitario   Float?
  estoqueMinimo   Float?
  controlaValidade Boolean       @default(false)
  proprietario    String         @default("Próprio")       // Próprio | Terceiro
  terceiroNome    String?
  terceiroDoc     String?
  ativo           Boolean        @default(true)
  observacao      String?
  legadoId        String?        @unique                   // item do módulo antigo que originou este material
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lotes           TfLote[]
  movimentos      TfMovimento[]
  receitasProduto TfReceita[]
  itensReceita    TfReceitaItem[]
  itensOrdem      TfOrdemItem[]
  ordensProduto   TfOrdem[]
  itensRequisicao TfRequisicaoItem[]
}

model TfLote {
  id         String        @id @default(uuid())
  materialId String
  material   TfMaterial    @relation(fields: [materialId], references: [id])
  codigo     String
  validade   DateTime?
  status     String        @default("Liberado") // Liberado | Quarentena | Bloqueado
  saldo      Float         @default(0)
  origem     String        @default("Entrada")  // Entrada | Transformação | Migração | Subproduto
  ordemId    String?
  documento  String?
  fornecedor String?
  createdAt  DateTime      @default(now())
  movimentos TfMovimento[]
  itensOrdem TfOrdemItem[]

  @@unique([materialId, codigo])
}

model TfMovimento {
  id            String     @id @default(uuid())
  seq           Int        @unique @default(autoincrement())
  dataHora      DateTime   @default(now())
  tipo          String     // ENTRADA | CONSUMO | PRODUCAO | SUBPRODUTO | PERDA | AJUSTE | SAIDA | ESTORNO
  materialId    String
  material      TfMaterial @relation(fields: [materialId], references: [id])
  loteId        String?
  lote          TfLote?    @relation(fields: [loteId], references: [id])
  quantidade    Float      // positivo entra, negativo sai
  saldoLoteApos Float?
  documento     String?
  ordemId       String?
  usuario       String
  usuarioId     String?
  motivo        String?
  hashAnterior  String?
  hash          String

  @@index([materialId, dataHora])
  @@index([ordemId])
}

model TfReceita {
  id                 String          @id @default(uuid())
  codigo             String
  versao             Int             @default(1)
  nome               String
  produtoId          String
  produto            TfMaterial      @relation(fields: [produtoId], references: [id])
  quantidadeBase     Float           @default(1)
  toleranciaAviso    Float           @default(3)   // % de desvio de rendimento que exige justificativa
  toleranciaBloqueio Float           @default(10)  // % de desvio que exige aprovação de outro usuário
  ativa              Boolean         @default(true)
  observacao         String?
  criadoPor          String
  createdAt          DateTime        @default(now())
  itens              TfReceitaItem[]
  ordens             TfOrdem[]

  @@unique([codigo, versao])
}

model TfReceitaItem {
  id         String     @id @default(uuid())
  receitaId  String
  receita    TfReceita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  materialId String
  material   TfMaterial @relation(fields: [materialId], references: [id])
  papel      String     @default("CONSUMO") // CONSUMO | SUBPRODUTO
  quantidade Float
}

model TfOrdem {
  id                  String        @id @default(uuid())
  codigo              String        @unique
  status              String        @default("Planejada") // Planejada | Aguardando aprovação | Concluída | Cancelada | Estornada
  receitaId           String?
  receita             TfReceita?    @relation(fields: [receitaId], references: [id])
  produtoId           String
  produto             TfMaterial    @relation(fields: [produtoId], references: [id])
  quantidadePlanejada Float
  quantidadeProduzida Float?
  rendimento          Float?        // % produzido / esperado pelo que foi consumido
  desvio              Float?        // rendimento - 100
  faixa               String?       // OK | Justificar | Aprovar | Sem receita
  justificativa       String?
  loteCodigo          String?
  validade            DateTime?
  observacao          String?
  criadoPor           String
  executadoPor        String?
  aprovadoPor         String?
  aprovadoEm          DateTime?
  createdAt           DateTime      @default(now())
  executadaEm         DateTime?
  concluidaEm         DateTime?
  canceladaEm         DateTime?
  estornadaEm         DateTime?
  motivoCancelamento  String?
  itens               TfOrdemItem[]
  requisicaoId        String?       // ✨ FASE 9: ordem gerada por uma requisição (Registro de transformação)
  requisicao          TfRequisicao? @relation(fields: [requisicaoId], references: [id])
}

model TfOrdemItem {
  id                  String     @id @default(uuid())
  ordemId             String
  ordem               TfOrdem    @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  papel               String     // CONSUMO | PRODUTO | SUBPRODUTO | PERDA
  materialId          String?
  material            TfMaterial? @relation(fields: [materialId], references: [id])
  loteId              String?
  lote                TfLote?    @relation(fields: [loteId], references: [id])
  quantidadePadrao    Float?
  quantidade          Float
  motivo              String?
}

model TfEvento {
  id           String   @id @default(uuid())
  seq          Int      @unique @default(autoincrement())
  dataHora     DateTime @default(now())
  entidade     String   // Material | Lote | Receita | Ordem | Sistema
  entidadeId   String?
  acao         String
  resumo       String
  antes        Json?
  depois       Json?
  usuario      String
  usuarioId    String?
  hashAnterior String?
  hash         String
}

// ============================================================
// ✨ FASE 7: ONDAS DE SEPARAÇÃO (batch picking com rota)
// ============================================================
model OndaSeparacao {
  id                   String               @id @default(uuid())
  codigo               String               @unique
  status               String               @default("Aberta") // Aberta | Em separação | Concluída | Cancelada
  armazemId            String?
  criadoPor            String
  separadorId          String?
  separadorNome        String?
  distanciaOnda        Float?               // metros estimados da rota única
  distanciaIndividual  Float?               // metros estimados separando ordem por ordem
  iniciadaEm           DateTime?
  concluidaEm          DateTime?
  createdAt            DateTime             @default(now())
  ordens               OrdemTransferencia[]

  @@index([status])
}

// ============================================================
// ✨ FASE 9: REGISTRO DE TRANSFORMAÇÃO (importado / inacabado → acabado)
// Ficha = modelo do registro (ex.: "Lenço Tá na Mão") com as receitas de saída possíveis.
// Requisição = um registro preenchido: 1) requisição e entrega, 2) conversão, 3) lançamento.
// ============================================================
model TfFicha {
  id          String           @id @default(uuid())
  codigo      String           @unique
  nome        String
  observacao  String?
  ativa       Boolean          @default(true)
  criadoPor   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  saidas      TfFichaSaida[]
  requisicoes TfRequisicao[]
}

model TfFichaSaida {
  id            String  @id @default(uuid())
  fichaId       String
  ficha         TfFicha @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  receitaCodigo String  // sempre usa a versão ativa da receita
  ordem         Int     @default(0)
}

model TfRequisicao {
  id                 String             @id @default(uuid())
  codigo             String             @unique
  fichaId            String
  ficha              TfFicha            @relation(fields: [fichaId], references: [id])
  status             String             @default("Solicitada") // Solicitada | Entregue | Convertida | Concluída | Cancelada | Estornada
  numeroViapro       String?
  solicitadoPor      String
  solicitadoEm       DateTime           @default(now())
  entreguePor        String?
  entregueEm         DateTime?
  registradoEntregaPor String?
  responsavelConversao String?
  convertidaEm       DateTime?
  avariaMotivo       String?
  lancadoPor         String?
  lancadoEm          DateTime?
  justificativa      String?
  observacao         String?
  canceladaEm        DateTime?
  motivoCancelamento String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  itens              TfRequisicaoItem[]
  ordens             TfOrdem[]
}

model TfRequisicaoItem {
  id                 String       @id @default(uuid())
  requisicaoId       String
  requisicao         TfRequisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  materialId         String
  material           TfMaterial   @relation(fields: [materialId], references: [id])
  quantidade         Float        // solicitada
  quantidadeEntregue Float?
  lotes              Json?        // [{ loteId, codigo, quantidade }] entregues pela logística
  avariada           Float        @default(0)
}
