generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        String    @id @default(uuid())
  nome      String
  descricao String?
  produtos  Produto[]
}

model Localizacao {
  id         String    @id @default(uuid())
  codigo     String    @unique
  zona       String
  corredor   String
  prateleira String
  estoques   Estoque[]
}

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  cargo         String
  email         String         @unique
  senha         String
  estoques      Estoque[]
  movimentacoes Movimentacao[]

  // ✨ RELAÇÕES PARA O MÓDULO WMS (SEPARAÇÃO) ✨
  ordensSolicitadas OrdemTransferencia[] @relation("OrdensSolicitadas")
  ordensSeparadas   OrdemTransferencia[] @relation("OrdensSeparadas")
}

model Produto {
  id                  String         @id @default(uuid())
  sku                 String         @unique
  nome                String
  descricao           String?
  codigoBarras        String?        @unique
  tipo                String         @default("ACABADO") 
  precoCusto          Float?         @default(0)
  precoVenda          Float?         @default(0)
  
  dataCadastro        DateTime       @default(now()) 
  
  lote                String?
  enderecoLocalizacao String?        
  fornecedorId        String?
  fornecedor          Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  
  categoriaId         String
  categoria           Categoria      @relation(fields: [categoriaId], references: [id])
  estoques            Estoque[]
  movimentacoes       Movimentacao[]
  
  pedidosCompra       PedidoCompra[]

  receitaParaOutros   Composicao[]   @relation("ProdutoFilho")
  ingredientes        Composicao[]   @relation("ProdutoPai")

  // ✨ RELAÇÃO PARA O MÓDULO WMS (SEPARAÇÃO) ✨
  itensTransferencia  ItemOrdemTransferencia[]
}

model Composicao {
  id             String  @id @default(uuid())
  produtoPaiId   String  // O Produto Final (Nacional/Montado)
  produtoFilhoId String  // A Matéria-Prima (Importado)
  quantidade     Int     // Quantidade necessária para montar 1 unidade

  produtoPai     Produto @relation("ProdutoPai", fields: [produtoPaiId], references: [id], onDelete: Cascade)
  produtoFilho   Produto @relation("ProdutoFilho", fields: [produtoFilhoId], references: [id])

  @@unique([produtoPaiId, produtoFilhoId]) 
}

model Estoque {
  id            String       @id @default(uuid())
  produtoId     String
  produto       Produto      @relation(fields: [produtoId], references: [id])
  quantidade    Int
  status        String       // Ex: 'Disponível', 'Em Demonstração'
  localizacaoId String?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation(fields: [responsavelId], references: [id])
}

model Movimentacao {
  id                  String    @id @default(uuid())
  produtoId           String
  usuarioId           String
  quantidade          Int
  tipoAcao            String    // 'Entrada de mercadoria', 'Devolução VIAPRO', etc.
  codigo              String?   // Campo para O "RE000126" e "RS000126"
  observacao          String?
  dataPrevistaRetorno DateTime?
  dataHora            DateTime  @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Fornecedor {
  id          String         @id @default(uuid())
  nomeEmpresa String
  cnpj        String?
  contatoNome String?
  telefone    String?
  email       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  produtos      Produto[]
  pedidosCompra PedidoCompra[]
}

model PedidoCompra {
  id           String      @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor  @relation(fields: [fornecedorId], references: [id])
  produtoId    String
  produto      Produto     @relation(fields: [produtoId], references: [id])
  codigo       String?     // O código sequencial PC000126
  quantidade   Int
  custoTotal   Float
  dataPrevisao DateTime?
  status       String      @default("Pendente") // 'Pendente' ou 'Recebido'
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// CAIXA PRETA DE AUDITORIA
model LogAuditoria {
  id          String   @id @default(uuid())
  acao        String
  itemNome    String
  usuarioNome String
  motivo      String   @db.Text
  dataHora    DateTime @default(now())
}

// ==========================================
// MÓDULO WMS: SEPARAÇÃO E TRANSFERÊNCIA
// ==========================================

model OrdemTransferencia {
  id            String    @id @default(uuid())
  codigo        String    @unique // Ex: OS-00124
  status        String    @default("Pendente") // Pendente, Em Separação, Concluída
  
  // ✨ A NOVA LINHA MÁGICA PARA DEFINIR O TIPO DE MOVIMENTAÇÃO ✨
  tipo          String    @default("SAIDA") // Pode ser: ENTRADA, SAIDA ou DEVOLUCAO
  
  // Quem pediu (Escritório/Fábrica)
  solicitanteId String
  solicitante   Usuario   @relation("OrdensSolicitadas", fields: [solicitanteId], references: [id])
  
  // Quem está separando (Armazém)
  separadorId   String?
  separador     Usuario?  @relation("OrdensSeparadas", fields: [separadorId], references: [id])

  itens         ItemOrdemTransferencia[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ItemOrdemTransferencia {
  id               String             @id @default(uuid())
  quantidade       Int
  marcado          Boolean            @default(false) // O "quadradinho" da conferência
  
  ordemId          String
  ordem            OrdemTransferencia @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  
  produtoId        String
  produto          Produto            @relation(fields: [produtoId], references: [id])
}